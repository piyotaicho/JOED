{
  "name": "joed5",
  "version": "2.0.2256",
  "description": "The procedures and adverse events regstration system provided by JSGOE (C) 2020-2025 P4mohnet and 日本産科婦人科内視鏡学会",
  "author": {
    "name": "Yasuhiro Yamamoto",
    "email": "p4@mohnet.com"
  },
  "licenses": [
    {
      "license": "MIT"
    }
  ],
  "main": "dist/background.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "serve": "vite",
    "build": "run-s type-check \"build-only --mode development {@}\" --",
    "build.production": "run-s type-check \"build-only --mode production {@}\" --",
    "lint": "eslint . --fix",
    "electron:serve": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 yarn run __electron_serve__",
    "__electron_serve__": "vite build --config vite.main.bundle.config.ts --mode development && electron-vite dev",
    "electron:build": "vite build --config vite.main.bundle.config.ts --mode development && electron-vite build --mode development && electron-builder --config electron-builder.config.cjs",
    "electron:build.nopack": "vite build --config vite.main.bundle.config.ts --mode development && electron-vite build --mode development&& electron-builder --dir --config electron-builder.config.cjs",
    "electron:build.production": "vite build --config vite.main.bundle.config.ts && electron-vite build --mode production && electron-builder --config electron-builder.config.cjs",
    "electron:build.production.nopack": "vite build --config vite.main.bundle.config.ts && electron-vite build --mode production && electron-builder --dir --config electron-builder.config.cjs",
    "preview": "vite build --config vite.main.bundle.config.ts && electron-vite preview",
    "build-only": "vite build",
    "test:unit": "vitest",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/",
    "dumpmaster": "bun --tsconfig-override ./jsconfig.json tools/generate-json.js"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "@vuepic/vue-datepicker": "^12.0.5",
    "electron-store": "^11.0.2",
    "element-plus": "^2.14.2",
    "encoding-japanese": "^2.2.0",
    "events": "^3.3.0",
    "fuse.js": "^7.4.2",
    "process": "^0.11.10",
    "util": "^0.12.5",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0",
    "vuex": "4.1.0",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "36.9.5",
    "electron-builder": "26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.8.4",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vitest": "^4.1.9",
    "vue-cli-plugin-electron-builder": "^2.1.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5",
    "wait-on": "^9.0.10"
  },
  "packageManager": "yarn@4.17.0"
}
